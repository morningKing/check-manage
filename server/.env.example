# Template for server/.env - copy to server/.env and fill in.
# Real `.env` is gitignored. config.py loads it at import time; existing
# real environment variables (e.g. set by docker-compose, CI, or your shell)
# win over file contents.

# ===== Database =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=casemanage
DB_USER=postgres
DB_PASSWORD=change-me

# ===== Flask =====
FLASK_PORT=3002
FLASK_DEBUG=false

# ===== JWT =====
# Production must set this. If empty, the backend falls back to a development
# default visible in source, allowing anyone who reads the repository to forge
# administrator tokens; startup prints a security warning.
#
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum length is 32 bytes (HS256 / RFC 7518 section 3.2). A shorter key
# fails during startup instead of at first login with "The HMAC key is N bytes
# long...". Changing the key invalidates all issued tokens.
#
# There is intentionally no default here. A copied dev-only value would expose
# the signing key, and an 18-byte key cannot sign tokens with PyJWT>=2.10.
# JWT_SECRET=
JWT_EXPIRY_HOURS=24

# ===== CORS =====
# Comma-separated list of frontend origins allowed to call the API.
# Leave blank to disable CORS (production behind a reverse proxy can leave empty).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== Open API =====
# Which branch the public Open API exposes; almost always "main".
OPEN_API_BRANCH=main

# ===== AI chat / Agent integration =====
# Workspace root lives OUTSIDE the repo on purpose - see config.py comment.
# Default: ~/.check-manage/ai-workspaces
# AI_WORKSPACE_ROOT=/var/lib/check-manage/ai-workspaces
OPENCODE_BASE_URL=http://127.0.0.1:4096
# OpenCode agent runtime launch — used by proxy.py startup AND the admin-page
# restart (OpenCode runtime management page); one shared source in
# server/utils/opencode_launch.py.
#   OPENCODE_BIN: opencode executable. Default 'opencode' (PATH lookup); on
#   Windows set the full .exe path — argv launching can't resolve npm's
#   .cmd wrapper without a shell.
# OPENCODE_BIN=C:\Users\me\AppData\Roaming\npm\node_modules\opencode-ai\bin\opencode.exe
#   OPENCODE_SERVE_CMD: full override command (shell-executed) for wrapper
#   scripts / service managers; wins over OPENCODE_BIN.
# OPENCODE_SERVE_CMD=opencode serve
#   Working directory for the spawned serve (default: ~, so no project-level
#   .opencode/ is picked up).
# OPENCODE_SERVE_CWD=~/
#   proxy.py: start serve automatically when unreachable at startup (default on).
# OPENCODE_AUTOSTART=1
MCP_SERVER_URL=http://127.0.0.1:3003
# MCP server bind address (used by mcp-server/main.py). Keep MCP_PORT in sync
# with the port in MCP_SERVER_URL / MCP_HEALTH_URL above.
MCP_HOST=127.0.0.1
MCP_PORT=3003
AI_SESSION_TTL_HOURS=24
AI_WORKSPACE_QUOTA_MB=200
# OpenCode model id: "<providerID>/<modelID>". The provider (with its API key)
# is configured in OpenCode's own global config, not here.
OPENCODE_MODEL=mimo/mimo-v2.5

# ===== Reverse proxy (production, server/proxy.py) =====
# Public listen address of the reverse proxy.
PROXY_HOST=0.0.0.0
PROXY_PORT=8080
# Where the proxy reaches the Flask backend; its PORT is also the port the proxy
# launches the backend on (so they can't drift). FLASK_PORT only governs the
# standalone dev server (npm run server).
BACKEND_URL=http://127.0.0.1:3001
# MCP server health endpoint the proxy probes on startup.
MCP_HEALTH_URL=http://127.0.0.1:3003/health
# Optional: explicit interpreter for the MCP server's own venv; auto-probed if unset.
# MCP_PYTHON=

# MCP <-> Flask internal memory channel (M2). Set a random secret to enable
# the agent's memory_* tools; leave empty to disable the internal endpoints (403).
MCP_INTERNAL_TOKEN=
FLASK_INTERNAL_URL=http://127.0.0.1:3002

# ===== Langfuse observability (optional) =====
# Set these only when a self-hosted Langfuse v4 project is available.
# LANGFUSE_ENABLED=true requires both project keys below; never commit real keys.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://langfuse.example.internal
LANGFUSE_PROJECT_ID=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=development
# Keep false unless the approved privacy policy permits prompt/response capture.
LANGFUSE_CAPTURE_CONTENT=false
# Stable trace sampling ratio: 0.0 disables export, 1.0 exports all traces.
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_QUEUE_SIZE=100
LANGFUSE_FLUSH_INTERVAL_SECONDS=5.0
