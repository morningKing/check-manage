# Template for server/.env — copy to server/.env and fill in.
# Real `.env` is gitignored. config.py loads it at import time; existing
# real environment variables (e.g. set by docker-compose, CI, or your shell)
# win over file contents.

# ===== Database =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=casemanage
DB_USER=postgres
DB_PASSWORD=change-me

# ===== Flask =====
FLASK_PORT=3002
FLASK_DEBUG=false

# ===== JWT =====
# 生产环境必须设置。留空/不设时后端会回落到源码里的开发默认值 —— 那是一个**公开
# 可见的常量**，任何读过仓库的人都能据此伪造管理员登录令牌；启动时会打印安全警告。
#
# 生成一个：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 长度下限 32 字节（HS256 / RFC 7518 §3.2）。配得太短，后端会在**启动时**直接报错，
# 而不是等到第一次登录才抛一句 "The HMAC key is N bytes long..."。
# 注意：更换密钥会使所有已签发的令牌失效，用户需重新登录。
#
# 这里刻意不给默认值 —— 原先给的是 dev-only-change-me，照抄的部署等于把钥匙公开了，
# 而且它只有 18 字节，在 PyJWT>=2.10 上根本签不出来。
# JWT_SECRET=
JWT_EXPIRY_HOURS=24

# ===== CORS =====
# Comma-separated list of frontend origins allowed to call the API.
# Leave blank to disable CORS (production behind a reverse proxy can leave empty).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== Open API =====
# Which branch the public Open API exposes; almost always "main".
OPEN_API_BRANCH=main

# ===== AI chat / Agent integration =====
# Workspace root lives OUTSIDE the repo on purpose — see config.py comment.
# Default: ~/.check-manage/ai-workspaces
# AI_WORKSPACE_ROOT=/var/lib/check-manage/ai-workspaces
OPENCODE_BASE_URL=http://127.0.0.1:4096
# OpenCode agent runtime launch — used by proxy.py startup AND the admin-page
# restart (OpenCode runtime management page); one shared source in
# server/utils/opencode_launch.py.
#   OPENCODE_BIN: opencode executable used by `opencode serve` (proxy.py 托管 /
#   管理页重启). Default 'opencode' (PATH lookup); on Windows set the full .exe
#   path — argv launching can't resolve npm's .cmd wrapper without a shell.
#   ★ 必须指向与 OPENCODE_DIR 相同版本的平台自带 oc126（1.2.26）；npm 全局
#   opencode 1.19.3 在该环境会失败。留空走 PATH 时请确认 PATH 里的版本是 oc126。
# OPENCODE_BIN=E:\wsl\check\check-manage\.dev-ai-workspaces\oc126\node_modules\opencode-windows-x64\bin\opencode.exe
#   OPENCODE_SERVE_CMD: full override command (shell-executed) for wrapper
#   scripts / service managers; wins over OPENCODE_BIN.
# OPENCODE_SERVE_CMD=opencode serve
#   Working directory for the spawned serve (default: ~, so no project-level
#   .opencode/ is picked up).
# OPENCODE_SERVE_CWD=~/
#   proxy.py: start serve automatically when unreachable at startup (default on).
# OPENCODE_AUTOSTART=1
MCP_SERVER_URL=http://127.0.0.1:3003
# MCP server bind address (used by mcp-server/main.py). Keep MCP_PORT in sync
# with the port in MCP_SERVER_URL / MCP_HEALTH_URL above.
MCP_HOST=127.0.0.1
MCP_PORT=3003
AI_SESSION_TTL_HOURS=24
AI_WORKSPACE_QUOTA_MB=200
# OpenCode model id: "<providerID>/<modelID>". The provider (with its API key)
# is configured in OpenCode's own global config, not here.
OPENCODE_MODEL=mimo/mimo-v2.5

# ===== Reverse proxy (production, server/proxy.py) =====
# Public listen address of the reverse proxy.
PROXY_HOST=0.0.0.0
PROXY_PORT=8080
# Where the proxy reaches the Flask backend; its PORT is also the port the proxy
# launches the backend on (so they can't drift). FLASK_PORT only governs the
# standalone dev server (npm run server).
BACKEND_URL=http://127.0.0.1:3001
# MCP server health endpoint the proxy probes on startup.
MCP_HEALTH_URL=http://127.0.0.1:3003/health
# Optional: explicit interpreter for the MCP server's own venv; auto-probed if unset.
# MCP_PYTHON=

# MCP <-> Flask internal memory channel (M2). Set a random secret to enable the
# agent's memory_* tools; leave empty to disable the internal endpoints (403).
MCP_INTERNAL_TOKEN=
FLASK_INTERNAL_URL=http://127.0.0.1:3002

# ---------------------------------------------------------------------------
# 智能写作（suggest-editor，Hocuspocus + ACP）——见 docs/user-guide/ai/suggest-editor.md
# ---------------------------------------------------------------------------
# agent 类型：mock（内置确定性规则，无需模型）| opencode（真 ACP agent）。
# dev:all 的 se script 钉 mock（保 E2E 确定性）；生产经 proxy 走本文件配置。
# AGENT_KIND=mock
# 分析模型 / 续写模型；id 用 `opencode models` 查。**留空 AGENT_MODEL 时自动采用
# 后台「AI 配置」页的默认模型**（显式 env 永远优先）。模型健康度会波动——
# 异常时先 `opencode run "hi" --model <id>` 单测（2026-10-19 实测 glm-5.3-flash
# 吐空响应、longcat 免费渠道 TLS 报错，deepseek-v4.1-flash 正常）。
# AGENT_MODEL=opencode-go/deepseek-v4.1-flash
# AGENT_MODEL_COMPLETE=opencode-go/deepseek-v4.1-flash
# ★ 强烈建议显式指到平台自带的 oc126 二进制：npm 全局 opencode 1.19.3 在 ACP 模式下
#   session/prompt 会返回 "OpenCode service failure"（2026-10-19 实测），oc126 正常。
#   OPENCODE_DIR 供 suggest-editor（ACP）用，OPENCODE_BIN 供 `opencode serve` 用，
#   两者务必指向同一份 oc126；否则会出现“编辑器分析正常但 AI 生成规则 502”的割裂。
# OPENCODE_DIR=E:\wsl\check\check-manage\.dev-ai-workspaces\oc126\node_modules\opencode-windows-x64\bin
